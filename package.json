{
  "name": "nuxt-pwa-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-pwa-icons.js && nuxt build",
    "clean": "node -e \"const { rmSync } = require('fs'); ['.nuxt', '.output', '.data', '.cache'].forEach(dir => rmSync(dir, { recursive: true, force: true }))\"",
    "clean-up": "pnpm clean",
    "dev": "nuxt dev",
    "generate": "node scripts/generate-pwa-icons.js && nuxt generate",
    "generate-icons": "node scripts/generate-pwa-icons.js",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@vueuse/nuxt": "^12.4.0",
    "nuxt": "^3.15.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@nuxt/devtools": "^1.7.0",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.6",
    "@vite-pwa/nuxt": "^0.10.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.2"
}
